root = true

[*]
indent_style = space
indent_size = 2
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
indent_size = 4

[*.{csproj,props,targets}]
indent_size = 2

# EF Core generates these; the array-literal / composite-index patterns it
# emits routinely trip analyzers that are otherwise appropriate for hand-written code.
[**/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none
